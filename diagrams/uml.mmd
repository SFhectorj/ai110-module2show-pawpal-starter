classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +update_availability(minutes) None
        +set_preference(key, value) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +str special_needs
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task_id) None
        +edit_task(task_id, changes) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +int id
        +str title
        +str category
        +int duration_minutes
        +str priority
        +str preferred_time
        +str description
        +str frequency
        +bool is_completed
        +date due_date
        +mark_complete() None
        +next_occurrence(new_id) Task
        +update(changes) None
    }

    class Scheduler {
        +Owner owner
        +generate_plan() DailyPlan
        +sort_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(completed, pet_name) list~Task~
        +complete_task(task_id) Task
        +find_conflicts() list~str~
        +fits_in_time(tasks) bool
        +explain_plan(plan) list~str~
    }

    class DailyPlan {
        +date date
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +dict explanations
        +add_entry(task, reason, scheduled) None
        +get_total_minutes() int
        +get_summary() str
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : schedules for
    Scheduler ..> Pet : adds recurring task to
    Scheduler ..> DailyPlan : creates
    Scheduler ..> Task : sorts, filters, completes
    Task ..> Task : next_occurrence creates copy
    DailyPlan o-- "0..*" Task : scheduled_tasks
    DailyPlan o-- "0..*" Task : skipped_tasks
